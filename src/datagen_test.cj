@Test
func datagenCrossTest(): Unit {
    var checked = 0
    for ((n, mpIdx, lpIdx, seed, want32, want64) in DATAGEN_REF) {
        let buf = Array<UInt8>(n, {_ => 0u8})
        RDG_genBuffer(buf, n, DATAGEN_MPS[mpIdx], DATAGEN_LPS[lpIdx], seed)
        let got32 = XXH32(buf, n, 0u32)
        let got64 = XXH64(buf, n, 0u64)
        if (got32 != want32 || got64 != want64) {
            println("MISMATCH n=${n} mp=${DATAGEN_MPS[mpIdx]} lp=${DATAGEN_LPS[lpIdx]} seed=${seed}: got xxh32=0x${got32} want 0x${want32}; got xxh64=0x${got64} want 0x${want64}")
        }
        @Assert(got32 == want32)
        @Assert(got64 == want64)
        checked += 1
    }
    @Assert(checked == 192)
}

@Test
func datagenDeterministicTest(): Unit {
    let a = Array<UInt8>(4096, {_ => 0u8})
    let b = Array<UInt8>(4096, {_ => 0u8})
    RDG_genBuffer(a, 4096, 0.5, 0.0, 7u32)
    RDG_genBuffer(b, 4096, 0.5, 0.0, 7u32)
    @Assert(a == b)
}
